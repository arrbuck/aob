#!/bin/sh
# Runs automatically before every commit. Blocks the commit if Gitleaks
# finds anything that looks like a secret (API key, token, password) in
# the files being committed. Fails closed: no Gitleaks, no commit.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found. Install it: winget install --id Gitleaks.Gitleaks -e" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --verbose
status=$?
if [ $status -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: possible secret found above. Commit blocked." >&2
  echo "Remove it from the file (keys belong in .dev.vars), then commit again." >&2
fi
exit $status
